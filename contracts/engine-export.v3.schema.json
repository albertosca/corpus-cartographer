{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-cartographer/engine-export/v3",
  "title": "Map engine input, written by the host app",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "taxonomy_version",
    "themes",
    "items",
    "previous",
    "rejected_pairs"
  ],
  "properties": {
    "rejected_pairs": {
      "description": "Item pairs the owner hid, lower id first; the engine never links them.",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "integer",
            "minimum": 1
          }
        ],
        "items": false,
        "minItems": 2
      }
    },
    "schema": {
      "const": "corpus-cartographer/engine-export"
    },
    "version": {
      "const": 3
    },
    "taxonomy_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_id",
          "name",
          "terms"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "parent_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "territories",
            "subthemes"
          ],
          "properties": {
            "territories": {
              "$ref": "#/$defs/positions"
            },
            "subthemes": {
              "$ref": "#/$defs/positions"
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "subtheme_id",
          "status",
          "badges",
          "terms"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "subtheme_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "enum": [
              "assigned",
              "needs_owner",
              "unclassified"
            ]
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "term"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "term": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
